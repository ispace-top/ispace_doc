# ============================================================
# iSpaceDoc Docker 环境配置模板
# 复制此文件为 .env 并修改为你自己的配置值
# cp .env.example .env
# ============================================================

# 数据库
DB_NAME=ispace
DB_USER=ispace
DB_PASSWORD=请修改为你的数据库密码
SECRET_KEY=请修改为随机的Django密钥

# Redis (留空则无密码，生产环境请设置)
REDIS_PASSWORD=

# Elasticsearch (生产环境请设置)
ELASTIC_PASSWORD=请修改为你的ES密码
ES_SECURITY_ENABLED=true

# 运行模式
DEBUG=false
APP_PORT=8000
API_PORT=8001
